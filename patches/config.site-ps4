# config.site for PS4 (OpenOrbis) cross-compilation of rakshasa/libtorrent
# Cached answers for AC_CHECK_FUNCS / AC_CHECK_HEADERS that cannot run on host.

# --- event backends: NONE available natively; we provide sceNetEpoll shim ---
ac_cv_func_kqueue=no
ac_cv_func_kqueue1=no
ac_cv_func_epoll_create=no
ac_cv_func_epoll_create1=no
ac_cv_func_poll=no
ac_cv_func_select=yes          # newlib provides select() over sceNetEpoll
ac_cv_func_pipe2=no
ac_cv_func_accept4=no
ac_cv_func_inotify_init=no
ac_cv_func_inotify_init1=no
ac_cv_func_fallocate=no
ac_cv_func_posix_fallocate=no
ac_cv_func_posix_fadvise=no
ac_cv_func_sendfile=no
ac_cv_func_madvise=no
ac_cv_func_mincore=no
ac_cv_func_pread=yes
ac_cv_func_pwrite=yes
ac_cv_func_mmap=no
ac_cv_func_clock_gettime=yes
ac_cv_func_getaddrinfo=yes
ac_cv_func_gethostbyname=yes
ac_cv_func_inet_pton=yes
ac_cv_func_inet_ntop=yes

# --- headers ---
ac_cv_header_sys_epoll_h=no
ac_cv_header_sys_event_h=no
ac_cv_header_sys_inotify_h=no
ac_cv_header_sys_mman_h=no
ac_cv_header_execinfo_h=no

# --- kqueue/epoll configure switches (rakshasa configure.ac) ---
# patched configure will accept --with-scenetpoll instead
