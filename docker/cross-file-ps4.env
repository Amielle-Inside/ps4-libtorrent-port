# OpenOrbis cross-compile environment (sourced inside container)
export OO_PS4_TOOLCHAIN=${OO_PS4_TOOLCHAIN:-/lib/OpenOrbisSDK}

# autotools: single-command cross compilers (wrappers created in Dockerfile)
export CC=ps4-clang
export CXX=ps4-clang++
export AR=llvm-ar
export RANLIB=llvm-ranlib
export STRIP=llvm-strip
export LD=ps4-clang

export CFLAGS="-O2 -D_GNU_SOURCE -include stdint.h -I/opt/ps4deps/include"
export CXXFLAGS="-O2 -D_GNU_SOURCE -include stdint.h -std=c++20 -I/opt/ps4deps/include -include cstdlib"
# note: -include cstdlib ensures ::abs exists before <cmath> (SDK libc++ issue)
# link recipe from toolchain samples/_common (crt1.o + link.x + explicit libs;
# wrappers pass -nostdlib so nothing host-side leaks in)
export LDFLAGS="-fuse-ld=lld \
  $OO_PS4_TOOLCHAIN/lib/crt1.o \
  -Wl,--script,$OO_PS4_TOOLCHAIN/link.x -Wl,--eh-frame-hdr -Wl,-pie \
  -L$OO_PS4_TOOLCHAIN/lib -L/opt/ps4deps/lib \
  -lc -lc++ -lkernel -lm -lpthread -lz"

# Tell autotools we're cross-compiling (no runtime tests possible)
export CONFIG_SITE=/src/patches/config.site-ps4
