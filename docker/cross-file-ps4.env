# OpenOrbis cross-compile environment (sourced)
export OO_PS4_TOOLCHAIN=${OO_PS4_TOOLCHAIN:-/opt/OpenOrbis-PS4-Toolchain}
export PATH="$OO_PS4_TOOLCHAIN/bin:$PATH"
export CROSS_PREFIX="$OO_PS4_TOOLCHAIN/bin/clang"

export CC="$CROSS_PREFIX"
export CXX="$CROSS_PREFIX++"
export AR="$OO_PS4_TOOLCHAIN/bin/llvm-ar"
export RANLIB="$OO_PS4_TOOLCHAIN/bin/llvm-ranlib"
export STRIP="$OO_PS4_TOOLCHAIN/bin/llvm-strip"
export LD="$CROSS_PREFIX"

# target triple sanity: toolchain ships bare clang targeting x86_64 (PS4 CPU)
export CFLAGS="-O2 -I$OO_PS4_TOOLCHAIN/include"
export CXXFLAGS="-O2 -std=c++17 -I$OO_PS4_TOOLCHAIN/include"
export LDFLAGS="-L$OO_PS4_TOOLCHAIN/lib"

# Tell autotools we're cross-compiling (no runtime tests possible)
export CONFIG_SITE=/src/patches/config.site-ps4
